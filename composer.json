{
    "name": "joomla/keychain",
    "type": "joomla-package",
    "description": "Joomla Keychain Package",
    "keywords": ["joomla", "framework", "keychain"],
    "homepage": "https://github.com/joomla-framework/keychain",
    "license": "LGPL-2.1-or-later",
    "require": {
        "php": "^8.3.0",
        "joomla/crypt": "^4.0",
        "joomla/registry": "^4.0"
    },
    "require-dev": {
        "joomla/console": "^4.0",
        "phpunit/phpunit": "^12.2.6",
        "squizlabs/php_codesniffer": "^3.7.2",
        "phpstan/phpstan": "^2.1.17",
        "phpstan/phpstan-deprecation-rules": "^2.0.3"
    },
    "suggest": {
        "joomla/console": "For managing a keychain through a command line interface"
    },
    "autoload": {
        "psr-4": {
            "Joomla\\Keychain\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Joomla\\Keychain\\Tests\\": "Tests/"
        }
    },
    "minimum-stability": "dev"
}
